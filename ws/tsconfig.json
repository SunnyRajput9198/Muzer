{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../",
    "baseUrl": ".",
    "paths": {
      "@muzer/*": ["../muzer/lib/*"]
    },
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": ["src","../muzer/lib"],
}
